<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: workouts (Room database) and settings go to Google backup and to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="ironindex.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="ironindex.xml" />
    </device-transfer>
</data-extraction-rules>
